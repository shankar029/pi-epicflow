#!/usr/bin/env bash
# pi-epic-validate-decomposition
#
# Validates the active epic's decomposition.yaml:
#   - Every feature has required fields
#   - Feature IDs sequential (F01, F02, ...)
#   - depends_on references valid features
#   - No cycles
#   - estimated_hours <= 16
#
# Exit 0 + "OK" on success, non-zero with errors on failure.

set -euo pipefail
# Resolve script dir through symlinks so we can source siblings reliably.
__src="${BASH_SOURCE[0]}"
while [ -L "$__src" ]; do
    __dir="$(cd -P "$(dirname "$__src")" && pwd)"
    __src="$(readlink "$__src")"
    [[ $__src != /* ]] && __src="$__dir/$__src"
done
__SCRIPT_DIR="$(cd -P "$(dirname "$__src")" && pwd)"
source "$__SCRIPT_DIR/_common.sh"

epic_dir=$(active_epic_dir)
repo=$(repo_root)
decomp="$epic_dir/decomposition.yaml"
[[ -f "$decomp" ]] || { echo "ERROR: $decomp not found" >&2; exit 1; }

# v0.7.1 / L-045 — integration-shell completeness flag.
SKIP_SHELL_CHECK=0
for arg in "$@"; do
    case "$arg" in
        --skip-shell-check) SKIP_SHELL_CHECK=1 ;;
        --help|-h)
            cat <<EOF
Usage: pi-epic-validate-decomposition [--skip-shell-check]

  --skip-shell-check   Bypass the v0.7.1 L-045 integration-shell completeness
                       check (warns/errors when AC contains trigger verbs like
                       'wire', 'register', 'integrate' but scope_files lacks a
                       language-appropriate integration shell). Logs a warning;
                       intended for spike epics or one-off bypass.
EOF
            exit 0
            ;;
    esac
done
export SKIP_SHELL_CHECK

python3 - "$decomp" "$repo" <<'PY'
import sys, re, os, glob

path = sys.argv[1]
repo_root = sys.argv[2] if len(sys.argv) > 2 else os.getcwd()

# YAML chars that, when leading an unquoted scalar, change semantics or fail
# strict parsers (L-020). Backtick is added because it crashes PyYAML.
UNSAFE_LEADING = set(['*', '&', '!', '|', '>', '%', '@', '`'])
GLOB_CHARS = set('*?[]{}')

# Sentinel values for AC strings that fall back to test-shaped checks even
# when the AC mentions a 'golden' / 'snapshot' / 'wire shape' but the
# literal sample is intentionally inline (fenced or quoted). The decomp
# prompt enforces inline samples; the validator only requires the term.
LITERAL_SAMPLE_TERMS = ('golden', 'snapshot', 'wire shape', 'wire format')
# L-029 (v0.5.2): match 'F01-F09', 'S04-S07', 'F12-S04' — any X-Y where
# both sides look like feature IDs. Used to flag range syntax in depends_on.
_RANGE_RE = re.compile(r'^[FSfs]\d+-[FSfs]\d+$')

# Minimal YAML reader for the schema we use. Tolerates the unsafe-leading
# chars (parser-friendly) so we can surface them as ERRORS rather than
# crashing.
def parse(p):
    out = {'features': []}
    cur = None
    cur_field = None
    cur_list = None
    top_list = None    # top-level list value (e.g. reference_paths)
    with open(p, encoding='utf-8') as f:
        for raw in f:
            line = raw.rstrip('\n')
            if not line.strip() or line.lstrip().startswith('#'):
                continue
            ind = len(line) - len(line.lstrip(' '))
            s = line.strip()

            if ind == 0:
                m = re.match(r'^([A-Za-z0-9_]+)\s*:\s*(.*)$', s)
                if m and m.group(1) == 'features':
                    cur = None; top_list = None
                    continue
                if m and m.group(1) == 'epic':
                    out['epic'] = m.group(2).strip().strip('"').strip("'")
                    top_list = None
                    continue
                if m:
                    k = m.group(1); v = m.group(2).strip()
                    if v == '':
                        out[k] = []; top_list = out[k]
                    elif v.startswith('[') and v.endswith(']'):
                        inner = v[1:-1].strip()
                        out[k] = [x.strip().strip('"').strip("'") for x in inner.split(',')] if inner else []
                        top_list = None
                    else:
                        out[k] = v.strip('"').strip("'"); top_list = None
                    cur = None
                    continue

            # Feature start: "- id: Fxx"
            if s.startswith('- ') and 'id:' in s:
                cur = {}
                out['features'].append(cur)
                rest = s[2:]
                m = re.match(r'^id\s*:\s*(.*)$', rest)
                if m:
                    cur['id'] = m.group(1).strip().strip('"').strip("'")
                cur_field = None
                cur_list = None
                top_list = None
                continue

            # List item (raw string AC or path)
            if s.startswith('- '):
                val = s[2:].strip()
                # Strip outer quoting if present; otherwise keep literal.
                if (val.startswith('"') and val.endswith('"')) or (val.startswith("'") and val.endswith("'")):
                    val_stripped = val[1:-1]
                    was_quoted = True
                else:
                    val_stripped = val
                    was_quoted = False
                target = cur_list if cur is not None else top_list
                if target is not None:
                    # Tag the entry with its unquoted status so AC-safety check
                    # can distinguish 'starts with *' (unsafe) from 'literal *'.
                    target.append({'value': val_stripped, 'was_quoted': was_quoted})
                continue

            if cur is None:
                continue

            # Field line
            m = re.match(r'^([A-Za-z0-9_]+)\s*:\s*(.*)$', s)
            if not m:
                continue
            k, v = m.group(1), m.group(2).strip()
            v = re.sub(r'\s+#.*$', '', v).strip()
            cur_field = k
            if v == '':
                cur[k] = []
                cur_list = cur[k]
            elif v == '[]':
                cur[k] = []
                cur_list = None
            elif v.startswith('[') and v.endswith(']'):
                inner = v[1:-1].strip()
                cur[k] = [{'value': x.strip().strip('"').strip("'"), 'was_quoted': False} for x in inner.split(',')] if inner else []
                cur_list = None
            else:
                cur[k] = v.strip('"').strip("'")
                cur_list = None

    return out

def _vals(lst):
    """Extract raw values from a list-of-dicts (our tagged list format)."""
    if not lst:
        return []
    out = []
    for entry in lst:
        if isinstance(entry, dict):
            out.append(entry.get('value', ''))
        else:
            out.append(str(entry))
    return out

data = parse(path)
errors = []
warnings = []

required = ['id','slug','summary','depends_on','scope_files','acceptance_criteria','estimated_hours']
ids_seen = []

# L-030 (v0.5.2): pre-compute per-directory scope_file counts across the
# entire decomposition. The "parent dir missing" warning suppresses when
# a directory has 2+ planned scope_files in it (signal: someone is
# building a new package on purpose, not a stale path).
_planned_dir_filecount = {}
for _ft in data.get('features', []) or []:
    for _entry in (_ft.get('scope_files') or []):
        _val = _entry.get('value', '') if isinstance(_entry, dict) else str(_entry)
        if not _val: continue
        if any(c in _val for c in '*?[]{}'): continue
        _d = os.path.dirname(_val)
        if _d:
            _planned_dir_filecount[_d] = _planned_dir_filecount.get(_d, 0) + 1

_FID_RE = re.compile(r'^F(\d+)([a-z]?)$')
_SID_RE = re.compile(r'^S(\d+)([a-z]?)$')
expected_idx = 1
seen_numeric = {}
for i, ft in enumerate(data.get('features', [])):
    fid = ft.get('id', f'<feature #{i+1}>')
    kind = (ft.get('kind') or 'feature').strip()
    if kind not in ('feature', 'spike'):
        errors.append(f"{fid}: kind must be 'feature' or 'spike' (got '{kind}')")
        kind = 'feature'

    # Required fields. Spikes may have empty scope_files (warning).
    for r in required:
        if r == 'scope_files' and kind == 'spike':
            continue   # check separately below
        if r not in ft:
            errors.append(f"{fid}: missing field '{r}'")

    # Sequential IDs. Spikes use S-prefix; features use F-prefix. Both share
    # the same numeric counter for ordering but live in separate namespaces.
    rid = ft.get('id', '')
    m_f = _FID_RE.match(rid)
    m_s = _SID_RE.match(rid)
    m = m_f or m_s
    if not m:
        if rid:
            errors.append(f"{fid}: id must match F<NN>[a-z] or S<NN>[a-z]")
    else:
        n = int(m.group(1))
        suf = m.group(2)
        if n == expected_idx:
            seen_numeric.setdefault(n, []).append(suf)
        elif n == expected_idx + 1 and seen_numeric.get(expected_idx):
            expected_idx += 1
            seen_numeric.setdefault(n, []).append(suf)
        else:
            errors.append(f"{fid}: expected id starting with F{expected_idx:02d}/S{expected_idx:02d} (or F{expected_idx+1:02d}/S{expected_idx+1:02d})")
        nxt = data.get('features', [])[i+1] if i + 1 < len(data.get('features', [])) else None
        nxt_id = (nxt or {}).get('id', '') if nxt else ''
        nxt_m = _FID_RE.match(nxt_id) or _SID_RE.match(nxt_id)
        if nxt is None or (nxt_m and int(nxt_m.group(1)) != n):
            pass
    ids_seen.append(rid)

    # Hours sanity. Spikes capped at 8h (decision spikes shouldn't be larger).
    try:
        hrs = float(ft.get('estimated_hours', 0))
        if hrs <= 0:
            errors.append(f"{fid}: estimated_hours must be > 0")
        max_hrs = 8 if kind == 'spike' else 16
        if hrs > max_hrs:
            errors.append(f"{fid}: estimated_hours={hrs} exceeds {max_hrs} ({'spikes capped at 8h' if kind=='spike' else 'features capped at 16h; split if larger'})")
        if hrs > (max_hrs // 2):
            warnings.append(f"{fid}: estimated_hours={hrs} is large for a {kind}")
    except (ValueError, TypeError):
        errors.append(f"{fid}: estimated_hours must be numeric")

    # Scope_files / AC presence
    sf = ft.get('scope_files') or []
    ac = ft.get('acceptance_criteria') or []
    if kind == 'spike':
        if sf:
            warnings.append(f"{fid} (spike): scope_files listed; spikes typically have none")
    else:
        if not sf:
            errors.append(f"{fid}: scope_files is empty")
    if not ac:
        errors.append(f"{fid}: acceptance_criteria is empty")
    if kind == 'spike' and len(_vals(ac)) < 1:
        errors.append(f"{fid} (spike): needs at least 1 decision-shaped acceptance criterion")

    # Self-dep
    deps = ft.get('depends_on') or []
    deps_vals = _vals(deps) if (deps and isinstance(deps[0], dict)) else list(deps)
    if rid in deps_vals:
        errors.append(f"{fid}: cannot depend on itself")

    # L-020: AC strings starting with unsafe YAML chars must be quoted.
    for j, entry in enumerate(ac):
        if not isinstance(entry, dict):
            continue
        val = entry.get('value', '')
        if not val: continue
        if entry.get('was_quoted'):
            continue
        first = val[0]
        if first in UNSAFE_LEADING:
            errors.append(
                f"{fid}: acceptance_criteria[{j}] starts with reserved YAML char '{first}' "
                f"and is unquoted. This breaks strict YAML parsers. Quote it: '\"{val}\"'.")

    # L-018 (stronger): if AC mentions a golden/snapshot/wire-shape concept,
    # check that *some* literal sample is inline (fenced ``` block, or a
    # quoted string, or an equals/colon-leading exact-value). Warn only.
    ac_blob = ' '.join(_vals(ac)).lower()
    if any(t in ac_blob for t in LITERAL_SAMPLE_TERMS):
        has_sample = any(
            '```' in (e.get('value','') if isinstance(e, dict) else '') or
            (isinstance(e, dict) and e.get('was_quoted') and len((e.get('value') or ''))>3)
            for e in ac
        )
        if not has_sample:
            warnings.append(
                f"{fid}: AC mentions golden/snapshot/wire-shape but no literal sample inline. "
                f"Add a fenced code block with the expected output, or quote the literal.")

    # L-021 + L-030 (v0.5.2): scope_files non-glob entries should exist on
    # the filesystem, OR their parent dir should be planned-by-the-epic
    # (i.e. some other scope_file in the corpus is going into the same new
    # directory). Suppress the "stale path" warning for greenfield
    # multi-file packages — prior to v0.5.2 the validator emitted one
    # noise warning per new-dir scope_file (smoke + gen-ui both flooded).
    for j, entry in enumerate(sf):
        val = entry.get('value', '') if isinstance(entry, dict) else str(entry)
        if not val: continue
        if any(c in val for c in GLOB_CHARS):
            continue
        abs_path = val if os.path.isabs(val) else os.path.join(repo_root, val)
        if not os.path.exists(abs_path):
            parent = os.path.dirname(abs_path) or repo_root
            if not os.path.isdir(parent):
                parent_rel = os.path.relpath(parent, repo_root)
                # Suppress if 2+ scope_files across the epic share this
                # parent dir — someone is intentionally building a new package.
                if _planned_dir_filecount.get(parent_rel, 0) >= 2:
                    pass
                else:
                    warnings.append(
                        f"{fid}: scope_files[{j}] '{val}' does not exist AND its parent dir is missing. "
                        f"Likely a stale path from an earlier layout. "
                        f"(If this is a new package, add a second scope_file under '{parent_rel}/' "
                        f"to confirm intent and silence this warning.)")
            else:
                # Parent exists → probably a file the feature creates. Skip.
                pass

    # needs_planner validation
    np_val = ft.get('needs_planner')
    if np_val is not None and str(np_val).strip().lower() not in ('true','false'):
        errors.append(f"{fid}: needs_planner must be true or false (got '{np_val}')")

# Build a global "symbols owned by scope_files" map for L-024 lookups.
# A scope_file like `src/pkg/errors.py` is taken to own the dotted prefix
# `pkg.errors` (we strip a leading `src/` / `lib/` / `app/` for ergonomics).
# This is a heuristic — false positives only produce warnings, never errors.
_SCOPE_PREFIX_STRIP = ('src/', 'lib/', 'app/', 'source/')
def _scope_to_modpath(p):
    s = p
    for pre in _SCOPE_PREFIX_STRIP:
        if s.startswith(pre):
            s = s[len(pre):]
            break
    s = re.sub(r'\.(py|ts|js|tsx|jsx|cs|go|rs|java|kt)$', '', s)
    s = s.rstrip('/').replace('/__init__', '').replace('/', '.')
    return s

_AC_SYMBOL_RE = re.compile(r'\b([a-z_][a-z0-9_]*(?:\.[a-z_][a-z0-9_]*)+)\.([A-Z]\w+)\b')
# L-024: when an AC names a dotted.module.ClassName path, the module file
# should be in scope_files (for this feature, or for an already-done dep).
# Warning-only: heuristic resolution to file path is fragile and we don't
# want to error on prose like "the foo.bar.Baz pattern in design.md".
_TYPING_BUILTINS = {'typing', 'collections', 'os', 'sys', 're', 'json',
                    'pathlib', 'subprocess', 'datetime', 'asyncio',
                    'unittest', 'pytest', 'logging', 'argparse', 'functools',
                    'itertools', 'dataclasses', 'enum', 'time', 'math'}
for ft in data.get('features', []):
    fid = ft.get('id', '?')
    kind = (ft.get('kind') or 'feature').strip()
    if kind == 'spike':
        continue  # spikes have no code scope to check
    ac = ft.get('acceptance_criteria') or []
    sf = _vals(ft.get('scope_files') or [])
    own_mods = {_scope_to_modpath(p) for p in sf if p}
    # Also collect dep-owned modules (deps must be earlier in the list).
    dep_mods = set()
    deps_vals = _vals(ft.get('depends_on') or [])
    for dft in data.get('features', []):
        if dft.get('id') in deps_vals:
            for p in _vals(dft.get('scope_files') or []):
                if p:
                    dep_mods.add(_scope_to_modpath(p))
    seen_syms = set()
    for entry in ac:
        s = entry.get('value', '') if isinstance(entry, dict) else str(entry)
        for m in _AC_SYMBOL_RE.finditer(s):
            modpath = m.group(1)
            if modpath in seen_syms:
                continue
            seen_syms.add(modpath)
            top = modpath.split('.', 1)[0]
            if top in _TYPING_BUILTINS:
                continue
            owned = any(om == modpath or om.startswith(modpath + '.') or
                        modpath.startswith(om + '.') for om in own_mods | dep_mods)
            if not owned:
                warnings.append(
                    f"{fid}: AC mentions symbol path '{modpath}.{m.group(2)}' but no "
                    f"scope_files entry (or dep's scope) maps to module '{modpath}'. "
                    f"L-024: add the owning file to scope_files, or you'll force "
                    f"an out-of-scope edit at implementation time.")

# v0.7.1 / L-045 — integration-shell completeness.
#
# Pattern caught: ~58 deviations across harmony + gen-ui where a worker built
# the new thing correctly but forgot to wire it into the host app. The AC
# triggers ('wire X into Y', 'register with Z', 'expose at /foo', 'integrate
# with Bar') signal cross-cutting work; if scope_files lists only the new
# thing and no language-appropriate integration shell, the worker has no
# mechanical reason to touch the shell and the per-feature reviewer's check
# is shaped around the new thing, not the boundary.
#
# Trigger verbs (case-insensitive, word-boundary):
_SHELL_TRIGGER_RE = re.compile(
    r'\b(wire|register|registered|registering|expose|exposes|exposed|integrate|integrates|integrated|integrating|mount|mounts|mounted|route|routes|routed|hook(?:\s+up)?|plug(?:\s+in)?|add\s+\S+\s+to|connect|connects|connected)\b',
    re.IGNORECASE)

# Detect target language(s) from scope_files extensions. Each language
# has a list of integration-shell *names* (basename match) that count as
# satisfying the gate. Match is permissive: if ANY scope_files entry is one
# of these basenames, the gate is satisfied for that language.
_SHELL_BY_LANG = {
    'ts_react':  ['vite.config.ts', 'vite.config.js', 'vite.config.mjs',
                  'main.tsx', 'main.ts', 'main.jsx', 'index.html',
                  'index.ts', 'index.tsx', 'index.js'],
    'ts_lib':    ['package.json', 'index.ts', 'index.tsx', 'index.js',
                  'tsconfig.json'],
    'csharp':    ['Program.cs', 'Startup.cs', 'Directory.Build.props',
                  'Directory.Packages.props'],
    'csharp_proj': ['.csproj', '.sln'],   # extension-based match
    'python':    ['pyproject.toml', 'setup.py', '__init__.py', 'conftest.py'],
    'rust':      ['Cargo.toml', 'lib.rs', 'main.rs', 'mod.rs'],
    'go':        ['go.mod', 'main.go'],
}

def _detect_langs(scope_files_list):
    """Return set of language tags for a scope_files list, by extension."""
    langs = set()
    for p in scope_files_list:
        if not p:
            continue
        base = os.path.basename(p)
        ext = os.path.splitext(p)[1].lower()
        if ext in ('.tsx', '.jsx'):
            langs.add('ts_react'); langs.add('ts_lib')
        elif ext in ('.ts', '.js', '.mjs', '.cjs'):
            langs.add('ts_lib')
            # If repo has a vite.config or index.html, also treat as ts_react.
            if any(os.path.exists(os.path.join(repo_root, c))
                   for c in ('vite.config.ts', 'vite.config.js', 'index.html')):
                langs.add('ts_react')
        elif ext == '.cs':
            langs.add('csharp'); langs.add('csharp_proj')
        elif ext == '.py':
            langs.add('python')
        elif ext == '.rs':
            langs.add('rust')
        elif ext == '.go':
            langs.add('go')
    return langs

def _scope_satisfies_shell(scope_files_list, langs):
    """True if any scope_files entry is an integration shell for one of the langs."""
    for p in scope_files_list:
        if not p:
            continue
        base = os.path.basename(p)
        ext = os.path.splitext(p)[1].lower()
        for lang in langs:
            shells = _SHELL_BY_LANG.get(lang, [])
            for shell in shells:
                if shell.startswith('.'):
                    # extension-based shell (e.g. '.csproj', '.sln')
                    if ext == shell:
                        return True
                else:
                    if base == shell:
                        return True
    return False

SKIP_SHELL_CHECK = os.environ.get('SKIP_SHELL_CHECK', '0') == '1'
shell_findings = []  # list of (fid, trigger_phrase, langs, scope_files)
if not SKIP_SHELL_CHECK:
    for ft in data.get('features', []):
        fid = ft.get('id', '?')
        kind = (ft.get('kind') or 'feature').strip()
        if kind == 'spike':
            continue
        ac = ft.get('acceptance_criteria') or []
        sf = _vals(ft.get('scope_files') or [])
        if not sf:
            continue  # already flagged as empty earlier
        # Check each AC for a trigger phrase.
        trigger = None
        for entry in ac:
            s = entry.get('value', '') if isinstance(entry, dict) else str(entry)
            m = _SHELL_TRIGGER_RE.search(s)
            if m:
                trigger = m.group(0)
                break
        # Also check summary (shorter, sometimes the only place the verb lives).
        if not trigger:
            m = _SHELL_TRIGGER_RE.search(ft.get('summary', '') or '')
            if m:
                trigger = m.group(0)
        if not trigger:
            continue
        langs = _detect_langs(sf)
        if not langs:
            # No detectable language — skip silently (heuristic not applicable)
            continue
        if not _scope_satisfies_shell(sf, langs):
            # Suggest concrete shell candidates for the detected languages.
            cands = []
            for lang in sorted(langs):
                cands.extend(_SHELL_BY_LANG.get(lang, [])[:3])
            cands = list(dict.fromkeys(cands))[:6]  # dedupe, cap at 6
            shell_findings.append((fid, trigger, sorted(langs), cands))

for fid, trig, langs, cands in shell_findings:
    errors.append(
        f"{fid}: AC/summary contains trigger '{trig}' (cross-cutting work) but "
        f"scope_files lacks a {'/'.join(langs)} integration shell. "
        f"L-045: add at least one of [{', '.join(cands)}] to scope_files, "
        f"or pass --skip-shell-check if this is a one-off bypass.")

# Unknown deps
all_ids = {ft.get('id') for ft in data.get('features', [])}
for ft in data.get('features', []):
    fid = ft.get('id', '?')
    deps = ft.get('depends_on') or []
    deps_vals = _vals(deps) if (deps and isinstance(deps[0], dict)) else list(deps)
    for d in deps_vals:
        # L-029 (v0.5.2): range syntax 'F06-F09' is not real YAML — the
        # dispatcher treats it as a literal (non-existent) feature ID.
        # Catch it specifically with a hint that points at the fix
        # (expand to explicit list).
        if _RANGE_RE.match(d):
            errors.append(
                f"{fid}: depends_on contains range syntax '{d}'. "
                f"Expand to an explicit list, e.g. depends_on: [F06, F07, F08, F09]. "
                f"YAML does not expand ranges; the dispatcher treats '{d}' as a "
                f"literal feature ID, silently breaking the dependency graph.")
            continue
        if d not in all_ids:
            errors.append(f"{fid}: depends_on '{d}' is not a defined feature")

# Cycle detection (DFS)
graph = {}
for ft in data.get('features', []):
    deps = ft.get('depends_on') or []
    deps_vals = _vals(deps) if (deps and isinstance(deps[0], dict)) else list(deps)
    graph[ft.get('id')] = deps_vals
WHITE, GRAY, BLACK = 0, 1, 2
color = {n: WHITE for n in graph}
def dfs(n, stack):
    color[n] = GRAY
    for m in graph.get(n, []):
        if m not in color: continue
        if color[m] == GRAY:
            errors.append(f"cycle in DAG: {' → '.join(stack + [m])}")
            return
        if color[m] == WHITE:
            dfs(m, stack + [m])
    color[n] = BLACK
for n in list(color.keys()):
    if color[n] == WHITE:
        dfs(n, [n])

# Epic-level reference_paths existence check (warning)
rp = data.get('reference_paths') or []
rp_vals = _vals(rp) if (rp and isinstance(rp[0], dict)) else list(rp)
for p in rp_vals:
    if not p: continue
    if any(c in p for c in GLOB_CHARS):
        continue
    abs_path = p if os.path.isabs(p) else os.path.join(repo_root, p)
    if not os.path.exists(abs_path):
        warnings.append(f"reference_paths: '{p}' does not exist on disk")

if warnings:
    print("WARNINGS:")
    for w in warnings: print(f"  - {w}")
if errors:
    print("ERRORS:")
    for e in errors: print(f"  - {e}")
    sys.exit(1)

# Summary stats
feats = data.get('features', [])
n_feat = sum(1 for f in feats if (f.get('kind') or 'feature') == 'feature')
n_spike = sum(1 for f in feats if (f.get('kind') or 'feature') == 'spike')
n_tagged = sum(1 for f in feats if str(f.get('needs_planner','')).lower() == 'true')
print(f"OK: {len(feats)} entries ({n_feat} features, {n_spike} spikes, {n_tagged} need planner), DAG valid.")
PY
