{
  "name": "pi-epicflow",
  "version": "0.8.1",
  "description": "Pi skill + prompt + agents for shipping multi-feature work autonomously: decompose a design.md into a DAG of small features, each on its own git worktree+branch off a long-lived epic branch, squash-merged back, then opened as a single PR. Halt only when truly blocked.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "epic",
    "feature-flow",
    "workflow",
    "git-worktree",
    "agentic",
    "subagents",
    "orchestrator"
  ],
  "license": "MIT",
  "author": "shankar029",
  "homepage": "https://github.com/shankar029/pi-epicflow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shankar029/pi-epicflow.git"
  },
  "bugs": {
    "url": "https://github.com/shankar029/pi-epicflow/issues"
  },
  "type": "module",
  "files": [
    "skills/**/*",
    "prompts/**/*",
    "agents/**/*",
    "install/**/*",
    "docs/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node install/postinstall.mjs || true",
    "test": "bash install/smoke-test.sh"
  },
  "pi": {
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
